	            SELECT
	                t.typname AS name,
	                n.nspname AS namespace
	            FROM pg_type t
	            JOIN pg_catalog.pg_namespace n ON n.oid = t.typnamespace
	            WHERE n.nspname = ANY ( $1 )
	              AND t.typtype = 'b' -- only base types
	              AND t.typinput::regproc::text <> 'array_in' -- exclude array types
	        
