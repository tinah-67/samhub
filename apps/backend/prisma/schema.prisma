generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ListingCategory {
  VEHICLE
  HOUSE
  LAND
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AuthCodePurpose {
  LOGIN
  SETUP
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  phone              String?
  passwordHash       String
  passwordMustChange Boolean    @default(false)
  role               UserRole   @default(STAFF)
  isActive           Boolean    @default(true)
  listings           Listing[]
  authCodes          AuthCode[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model AuthCode {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthCodePurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, purpose, expiresAt])
}

model Listing {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  category     ListingCategory
  status       ListingStatus   @default(DRAFT)
  description  String
  price        Decimal?        @db.Decimal(14, 2)
  currency     String          @default("KES")
  location     String
  address      String?
  featured     Boolean         @default(false)
  imageUrls    String[]
  bedrooms     Int?
  bathrooms    Int?
  areaSize     String?
  lotSize      String?
  make         String?
  model        String?
  year         Int?
  mileage      Int?
  transmission String?
  fuelType     String?
  condition    String?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  inquiries    Inquiry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, status])
  @@index([featured, status])
}

model Inquiry {
  id               String        @id @default(cuid())
  listingId        String?
  listing          Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  name             String
  email            String?
  phone            String
  preferredContact String        @default("phone")
  message          String
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([listingId])
}
