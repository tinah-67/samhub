runExec 
      CREATE OR REPLACE FUNCTION "_prisma_dev_wal"."capture_event"()
      RETURNS trigger
      LANGUAGE plpgsql
      AS $$
      BEGIN
        IF TG_TABLE_SCHEMA = '_prisma_dev_wal' THEN
          RETURN COALESCE(NEW, OLD);
        END IF;

        INSERT INTO "_prisma_dev_wal"."events" (
          txid,
          schema_name,
          table_name,
          op,
          row_data,
          old_row_data
        )
        VALUES (
          txid_current(),
          TG_TABLE_SCHEMA,
          TG_TABLE_NAME,
          lower(TG_OP),
          CASE WHEN TG_OP IN ('INSERT', 'UPDATE') THEN to_jsonb(NEW) ELSE NULL END,
          CASE WHEN TG_OP IN ('UPDATE', 'DELETE') THEN to_jsonb(OLD) ELSE NULL END
        );

        RETURN COALESCE(NEW, OLD);
      END;
      $$;
     undefined
runExec 
      CREATE OR REPLACE FUNCTION "_prisma_dev_wal"."install_all_triggers"()
      RETURNS void
      LANGUAGE plpgsql
      AS $$
      DECLARE
        target REGCLASS;
      BEGIN
        FOR target IN
          SELECT c.oid::regclass
          FROM pg_class AS c
          JOIN pg_namespace AS n ON n.oid = c.relnamespace
          WHERE c.relkind IN ('r', 'p')
            AND n.nspname NOT IN ('_prisma_dev_wal', 'information_schema', 'pg_catalog')
            AND n.nspname NOT LIKE 'pg_temp_%'
            AND n.nspname NOT LIKE 'pg_toast%'
        LOOP
          IF EXISTS (
            SELECT 1
            FROM pg_trigger
            WHERE tgrelid = target
              AND tgname = 'prisma_dev_wal_capture'
          ) THEN
            CONTINUE;
          END IF;

          EXECUTE format(
            'CREATE TRIGGER %I AFTER INSERT OR UPDATE OR DELETE ON %s FOR EACH ROW EXECUTE FUNCTION "_prisma_dev_wal"."capture_event"()',
            'prisma_dev_wal_capture',
            target::text
          );
        END LOOP;
      END;
      $$;
     undefined
